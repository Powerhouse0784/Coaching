generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String?
  password           String?
  role               String               @default("STUDENT")
  avatar             String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bio                String?
  dateOfBirth        DateTime?
  experience         String?
  instagram          String?
  linkedin           String?
  location           String?
  phone              String?
  qualification      String?
  specialization     String?
  subjects           String?
  teachingStyle      String?
  twitter            String?
  website            String?
  orders             Order[]
  accounts           Account[]
  iMessages          AIAssistantMessage[] @relation("UserAIMessages")
  assignmentComments AssignmentComment[]  @relation("UserAssignmentComments")
  doubtReplies       DoubtReply[]         @relation("UserDoubtReplies")
  doubtReplyUpvotes  DoubtReplyUpvote[]   @relation("UserDoubtReplyUpvotes")
  doubtUpvotes       DoubtUpvote[]        @relation("UserDoubtUpvotes")
  paymentOrders      PaymentOrder[]
  sessions           Session[]
  student            Student?             @relation("UserStudent")
  chatMessages       TeacherChatMessage[] @relation("UserChatMessages")
  teacher            Teacher?             @relation("UserTeacher")
  videoProgress      VideoProgress[]

  @@map("users")
}

model Student {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  assignmentSubmissions AssignmentSubmission[] @relation("StudentAssignmentSubmissions")
  doubts                Doubt[]                @relation("StudentDoubts")
  enrollments           Enrollment[]
  noteBookmarks         NoteBookmark[]         @relation("StudentNoteBookmarks")
  user                  User                   @relation("UserStudent", fields: [userId], references: [id])
  submissions           Submission[]

  @@map("students")
}

model Teacher {
  id            String         @id @default(uuid())
  userId        String         @unique
  experience    String?
  rating        Float?         @default(0)
  assignments   Assignment[]
  assignmentsV2 AssignmentV2[] @relation("TeacherAssignments")
  courses       Course[]
  notes         Note[]         @relation("TeacherNotes")
  user          User           @relation("UserTeacher", fields: [userId], references: [id])
  videoFolders  VideoFolder[]

  @@map("teachers")
}

model Category {
  id      String   @id @default(uuid())
  name    String
  slug    String   @unique
  courses Course[]

  @@map("categories")
}

model Course {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  description String
  price       Float
  level       String       @default("Beginner")
  language    String       @default("English")
  thumbnail   String?
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teacherId   String
  categoryId  String?
  assignments Assignment[]
  category    Category?    @relation(fields: [categoryId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  modules     Module[]

  @@map("courses")
}

model Module {
  id       String    @id @default(uuid())
  title    String
  order    Int
  courseId String
  lectures Lecture[]
  course   Course    @relation(fields: [courseId], references: [id])

  @@map("modules")
}

model Lecture {
  id       String  @id @default(uuid())
  title    String
  duration Int
  order    Int
  isFree   Boolean @default(false)
  videoUrl String?
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id])

  @@map("lectures")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Assignment {
  id          String       @id @default(uuid())
  title       String
  description String
  totalMarks  Int
  dueDate     DateTime
  fileUrl     String?
  createdAt   DateTime     @default(now())
  teacherId   String
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String     @id @default(uuid())
  content      String?
  fileUrl      String?
  marks        Int?
  feedback     String?
  isEvaluated  Boolean    @default(false)
  submittedAt  DateTime   @default(now())
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model AssignmentV2 {
  id          String                 @id @default(uuid())
  title       String
  description String
  subject     String
  class       String
  dueDate     DateTime
  totalMarks  Int
  fileUrl     String?
  fileName    String?
  fileSize    String?
  isPublished Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  teacherId   String
  comments    AssignmentComment[]
  submissions AssignmentSubmission[]
  teacher     Teacher                @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([subject])
  @@index([class])
  @@index([dueDate])
  @@map("assignments_v2")
}

model AssignmentSubmission {
  id           String       @id @default(uuid())
  fileUrl      String
  fileName     String
  fileSize     String
  remarks      String?
  status       String       @default("pending")
  isCompleted  Boolean      @default(false)
  submittedAt  DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignmentId String
  studentId    String
  assignment   AssignmentV2 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student      @relation("StudentAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions_v2")
}

model AssignmentComment {
  id           String       @id @default(uuid())
  content      String
  fileUrl      String?
  fileName     String?
  fileSize     String?
  likes        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignmentId String
  userId       String
  assignment   AssignmentV2 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User         @relation("UserAssignmentComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
  @@map("assignment_comments")
}

model VideoFolder {
  id                String   @id @default(uuid())
  name              String
  subject           String
  class             String
  chapter           String
  description       String?
  thumbnail         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  teacherId         String
  isPublic          Boolean  @default(true)
  youtubePlaylistId String?
  teacher           Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  videos            Video[]

  @@map("video_folders")
}

model Video {
  id          String          @id @default(uuid())
  title       String
  description String?
  videoUrl    String
  duration    String          @default("0:00")
  thumbnail   String?
  size        String?
  quality     String          @default("1080p")
  views       Int             @default(0)
  uploadDate  DateTime        @default(now())
  folderId    String
  order       Int             @default(0)
  progress    VideoProgress[]
  folder      VideoFolder     @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model VideoProgress {
  id                String   @id @default(uuid())
  watchedPercentage Int      @default(0)
  lastPosition      Int      @default(0)
  completed         Boolean  @default(false)
  bookmarked        Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  userId            String
  videoId           String
  createdAt         DateTime @default(now())
  watchDuration     Int      @default(0)
  viewCounted       Boolean  @default(false)
  watchedSeconds    Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_progress")
}

model ContactSubmission {
  id        String    @id @default(uuid())
  name      String
  email     String
  subject   String
  category  String
  message   String
  status    String    @default("pending")
  priority  String    @default("normal")
  ipAddress String?
  userAgent String?
  repliedAt DateTime?
  repliedBy String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("contact_submissions")
}

model ChatConversation {
  id        String        @id @default(uuid())
  sessionId String?
  userId    String?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  messages  ChatMessage[]

  @@index([sessionId])
  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  role           String
  content        String
  model          String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

model Doubt {
  id          String        @id @default(uuid())
  title       String
  description String
  subject     String
  class       String?
  priority    String        @default("normal")
  imageUrl    String?
  imageName   String?
  pdfUrl      String?
  pdfName     String?
  status      String        @default("open")
  isSolved    Boolean       @default(false)
  solvedAt    DateTime?
  views       Int           @default(0)
  upvotes     Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  studentId   String
  replies     DoubtReply[]
  upvotedBy   DoubtUpvote[]
  student     Student       @relation("StudentDoubts", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subject])
  @@index([status])
  @@index([createdAt])
  @@map("doubts")
}

model DoubtReply {
  id         String             @id @default(uuid())
  content    String
  imageUrl   String?
  imageName  String?
  pdfUrl     String?
  pdfName    String?
  isPinned   Boolean            @default(false)
  isAccepted Boolean            @default(false)
  upvotes    Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  doubtId    String
  userId     String
  doubt      Doubt              @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user       User               @relation("UserDoubtReplies", fields: [userId], references: [id], onDelete: Cascade)
  upvotedBy  DoubtReplyUpvote[]

  @@index([doubtId])
  @@index([userId])
  @@index([isPinned])
  @@map("doubt_replies")
}

model DoubtUpvote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  doubtId   String
  userId    String
  doubt     Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user      User     @relation("UserDoubtUpvotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doubtId, userId])
  @@map("doubt_upvotes")
}

model DoubtReplyUpvote {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  replyId   String
  userId    String
  reply     DoubtReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User       @relation("UserDoubtReplyUpvotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@map("doubt_reply_upvotes")
}

model Note {
  id           String         @id @default(uuid())
  title        String
  description  String?
  subject      String
  class        String
  topic        String?
  chapter      String?
  fileUrl      String
  fileName     String
  fileType     String
  fileSize     String
  thumbnailUrl String?
  isPublished  Boolean        @default(true)
  isPinned     Boolean        @default(false)
  downloads    Int            @default(0)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  teacherId    String
  price        Int            @default(30)
  bookmarks    NoteBookmark[]
  teacher      Teacher        @relation("TeacherNotes", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([subject])
  @@index([class])
  @@index([isPublished])
  @@index([isPinned])
  @@index([createdAt])
  @@map("notes")
}

model NoteBookmark {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  noteId    String
  studentId String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student   Student  @relation("StudentNoteBookmarks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([noteId, studentId])
  @@map("note_bookmarks")
}

model TeacherChatMessage {
  id        String   @id @default(uuid())
  content   String
  fileUrl   String?
  fileName  String?
  fileType  String?
  fileSize  String?
  isRead    Boolean  @default(false)
  readBy    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  senderId  String
  sender    User     @relation("UserChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
  @@map("teacher_chat_messages")
}

model AIAssistantMessage {
  id        String   @id @default(uuid())
  content   String
  fileUrl   String?
  fileName  String?
  fileType  String?
  fileSize  String?
  isAI      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacherId String
  teacher   User     @relation("UserAIMessages", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([createdAt])
  @@index([isAI])
  @@map("ai_assistant_messages")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}

model PaymentOrder {
  id              String             @id @default(uuid())
  orderId         String             @unique
  paymentId       String?
  signature       String?
  amount          Int
  currency        String             @default("INR")
  status          String             @default("pending")
  couponCode      String?
  couponDiscount  Int                @default(0)
  deliveryAddress Json?
  userId          String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           PaymentOrderItem[]
  user            User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payment_orders")
}

model PaymentOrderItem {
  id        String       @id @default(uuid())
  orderId   String
  type      String
  refId     String
  name      String
  qty       Int          @default(1)
  unitPrice Int
  total     Int
  createdAt DateTime     @default(now())
  order     PaymentOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_order_items")
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  userEmail       String
  userName        String?
  userPhone       String?
  items           Json
  subtotal        Int
  couponDiscount  Int      @default(0)
  total           Int
  couponCode      String?
  address         Json?
  paymentMethod   String?
  paymentProof    String?
  status          String   @default("pending")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])
}
